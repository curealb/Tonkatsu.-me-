# Tonkatsu.(me) — keep source code, timelines, docs and converted ASCII art in Git.
# Ignore local music, working artwork, exports, caches and private settings.

# Python bytecode, environments and local tooling
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
__pypackages__/
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/
.pytest_cache/
.hypothesis/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Test, coverage, benchmark and browser-generated outputs
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
nosetests.xml
/test-results/
/playwright-report/
/.playwright/

# JS tooling, if the web preview is extended
node_modules/
.npm/
.yarn/cache/
.parcel-cache/
.vite/

# Builds, exports and distributable archives
/dist/
/build/
/.build/
/out/
/output/
/exports/
/renders/
*.pyz
*.whl
*.egg
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.dmg
*.exe
*.app/

